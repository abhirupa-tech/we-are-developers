# Copy to .env.local (git-ignored) and fill in. Used by Live mode only.
# Vite inlines VITE_ variables into the browser bundle, so keep this to local
# demos: never deploy a build that contains your key.
VITE_GEMINI_API_KEY=
# Optional. Any model that supports streamGenerateContent.
# VITE_GEMINI_MODEL=gemini-flash-latest
