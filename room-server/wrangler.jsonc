{
  // MockGPT room: live, shared frame stats for a whole audience.
  // Runs on the Cloudflare Workers Free plan (no card): Durable Objects with
  // the SQLite storage backend are included there.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mockgpt-room",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
